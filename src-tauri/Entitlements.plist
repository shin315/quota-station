<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The entitlements Tauri signs the app with (bundle.macOS.entitlements).
     Apple Events: switching Antigravity accounts asks Antigravity to quit
     through /usr/bin/osascript, which macOS allows a hardened-runtime app
     (the signed, notarized release) only with this entitlement. A build
     from source, signed again by scripts/install.sh, has no hardened
     runtime and does not need it. -->
<plist version="1.0">
<dict>
	<key>com.apple.security.automation.apple-events</key>
	<true/>
</dict>
</plist>
