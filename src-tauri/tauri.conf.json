{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Quota Station",
  "version": "0.1.0",
  "identifier": "com.shin315.quota-station",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "popover",
        "title": "Quota Station",
        "url": "index.html",
        "width": 348,
        "height": 560,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "visible": false,
        "focus": false,
        "shadow": true,
        "acceptFirstMouse": true,
        "windowEffects": {
          "effects": ["popover"],
          "state": "active",
          "radius": 16
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "Utility",
    "shortDescription": "AI coding quota in the menu bar",
    "copyright": "CC BY-NC-SA 4.0. Personal, non-commercial.",
    "license": "CC-BY-NC-SA-4.0",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-"
    }
  }
}
