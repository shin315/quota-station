<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Merged into the bundle's Info.plist by Tauri. QuotaStationAgents: the
     version of the copy between Macs (M13) this app speaks; another Mac
     runs `quota-station agents` here only when it is there.
     NSAppleEventsUsageDescription: what macOS shows when it first asks
     whether Quota Station may control Antigravity (quitting it before an
     account switch). -->
<plist version="1.0">
<dict>
	<key>QuotaStationAgents</key>
	<integer>1</integer>
	<key>NSAppleEventsUsageDescription</key>
	<string>Quota Station cần thoát Antigravity trước khi chuyển tài khoản Antigravity.</string>
</dict>
</plist>
